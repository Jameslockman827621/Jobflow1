# Copy to .env and adjust for your environment

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-32-plus-random-characters-not-change-me

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobscale
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobscale

REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

APP_URL=http://localhost:3000

# Optional: LinkedIn / Indeed via Apify
APIFY_API_KEY=

# Email (production: configure SendGrid or SMTP)
SENDGRID_API_KEY=
SMTP_USER=
SMTP_PASSWORD=

# Stripe — create Products/Prices in Dashboard, paste Price IDs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# When true (default), empty DB gets curated demo jobs if scrapers return nothing
AUTO_SEED_DEMO_JOBS=true

# --- Apply engine / Tsenta-class automation ---

# 2Captcha (leave empty + CAPTCHA_MOCK=true for local dry runs)
TWOCAPTCHA_API_KEY=
CAPTCHA_MOCK=false

# Comma-separated proxy URLs for scrape/apply evasion
PROXY_POOL=

# WhatsApp (Twilio) + iMessage bridge
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
IMESSAGE_BRIDGE_URL=

# Headless Playwright apply (server-side queue via Celery)
HEADLESS_APPLY_ENABLED=true
# Platform kill-switch (user must ALSO opt in via dashboard auto_apply_submit)
HEADLESS_APPLY_AUTO_SUBMIT=true

# LinkedIn / Indeed Easy Apply need a logged-in Playwright storage_state
# Upload via: PUT /api/v1/apply-engine/board-sessions/{linkedin|indeed}
# Body: { "storage_state": { "cookies": [...], "origins": [...] } }

# Generic webhook HMAC for inbound messaging / partner hooks
WEBHOOK_SECRET=

# Observability (optional)
SENTRY_DSN=

# Google OAuth (optional — Continue with Google on login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {APP_URL}/api/v1/auth/google/callback when empty
GOOGLE_REDIRECT_URI=

# Admin emails allowed to trigger scrapes / ops metrics (comma-separated)
ADMIN_EMAILS=
